<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cly.doctorservice.mapper.DoctorMapper">
    <!--根据状态查询所有医生信息-->
    <select id="selectDoctorByStatus" resultType="com.cly.doctorservice.entity.Doctor">
        SELECT *
        FROM yy_doctor
        WHERE status = #{status}
    </select>
    
    <update id="updateFeeById">
        UPDATE yy_doctor
        SET fee = #{fee}
        WHERE id = #{id}
    </update>
</mapper>

